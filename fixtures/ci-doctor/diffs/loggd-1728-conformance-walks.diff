--- /dev/null
+++ b/src/test/ratchet-base.ts
@@ -0,0 +1,57 @@
+import { execFileSync } from "node:child_process";
+
+/**
+ * The revision a "may only shrink" ratchet reads its old baseline from.
+ *
+ * A ratchet asks whether THIS branch added an entry. Comparing against the tip
+ * of the base branch asks something else: whether the branch has every removal
+ * `main` made since it was cut. With several agents shrinking the same lists
+ * all day, a branch cut an hour ago "grows" a list it never touched, and its
+ * build goes red for a commit it does not contain (PR #1728, build 2454:
+ * `MOBILE_ENVELOPE_CALLERS` after #1726 shrank it on `main`).
+ *
+ * So the comparison point is `git merge-base HEAD <baseRef>`: where the branch
+ * left the base. On a Mergify merge-queue build the checked-out tree is the
+ * base tip plus the batch, so the merge-base is that tip, which is the same
+ * comparison as before. On `main` it is `HEAD` itself, as before.
+ *
+ * When the merge-base cannot be computed (an unfetched ref, a shallow history),
+ * this returns `baseRef` unchanged. Each ratchet's own `rev-parse` check then
+ * still fails loudly in CI or skips locally, and a resolvable but unrelated
+ * ref still falls back to the stricter tip comparison.
+ */
+export type ReadGit = (...args: string[]) => string | null;
+
+export const readGit: ReadGit = (...args) => {
+  try {
+    return execFileSync("git", args, {
+      cwd: process.cwd(),
+      encoding: "utf8",
+      stdio: ["ignore", "pipe", "ignore"],
+    });
+  } catch {
+    return null;
+  }
+};
+
+export function ratchetBase(baseRef: string, git: ReadGit = readGit): string {
+  const commit = git("merge-base", "HEAD", baseRef)?.trim();
+  return commit && /^[0-9a-f]{7,64}$/.test(commit) ? commit : baseRef;
+}
+
+/**
+ * A fake `readGit` for a branch cut from `baseRef` before the base moved on:
+ * `show` answers from `atMergeBase` at the merge-base and from `atTip` at the
+ * tip. It lets a ratchet's own tests pin the stale-branch case.
+ */
+export const MERGE_BASE = "0123456789abcdef0123456789abcdef01234567";
+export const forkedHistory = (file: string, atMergeBase: string, atTip: string): ReadGit =>
+  (...args) => {
+    switch (args[0]) {
+      case "rev-parse": return `${"f".repeat(40)}\n`;
+      case "merge-base": return `${MERGE_BASE}\n`;
+      case "ls-tree": return `${file}\n`;
+      case "show": return args[1]?.startsWith(`${MERGE_BASE}:`) ? atMergeBase : atTip;
+      default: return null;
+    }
+  };
