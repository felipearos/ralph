+// @vitest-environment node
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+
+import { MERGE_BASE, forkedHistory, ratchetBase, type ReadGit } from "./ratchet-base";
+
+describe("ratchetBase", () => {
+  it("answers the merge-base of HEAD and the base ref", () => {
+    const calls: string[][] = [];
+    const git: ReadGit = (...args) => (calls.push(args), `${MERGE_BASE}\n`);
+    expect(ratchetBase("origin/main", git)).toBe(MERGE_BASE);
+    expect(calls).toEqual([["merge-base", "HEAD", "origin/main"]]);
+  });
+
+  it("falls back to the base ref when there is no merge-base", () => {
+    expect(ratchetBase("origin/main", () => null)).toBe("origin/main");
+    expect(ratchetBase("origin/main", () => "")).toBe("origin/main");
+    expect(ratchetBase("origin/main", () => "not a commit\n")).toBe("origin/main");
+  });
+
+  it("fakes a stale branch: the merge-base and the tip answer differently", () => {
+    const git = forkedHistory("f.ts", "old", "new");
+    expect(git("show", `${ratchetBase("origin/main", git)}:f.ts`)).toBe("old");
+    expect(git("show", "origin/main:f.ts")).toBe("new");
+  });
+});
+
+/**
+ * The same questions against a real repository, because what matters is what
+ * git answers, not what a fake was told to.
+ */
+describe("ratchetBase against real history", () => {
+  let dir = "";
+  const git = (...args: string[]) =>
+    execFileSync("git", args, { cwd: dir, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
+  const readIn: ReadGit = (...args) => {
+    try { return git(...args); } catch { return null; }
+  };
+  const commit = (content: string) => {
+    writeFileSync(path.join(dir, "allowlist.ts"), content);
+    git("add", "allowlist.ts");
+    git("-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q", "-m", content);
+    return git("rev-parse", "HEAD");
+  };
+
+  beforeAll(() => {
+    dir = mkdtempSync(path.join(tmpdir(), "ratchet-base-"));
+    git("init", "-q", "-b", "main");
+  });
+  afterAll(() => rmSync(dir, { recursive: true, force: true }));
+
+  it("reads a stale branch's baseline from where it forked, and a queue batch's from the tip", () => {
+    const fork = commit("a b c");
+    git("checkout", "-q", "-b", "feature");
+    commit("a b c // unrelated change");
+    git("checkout", "-q", "main");
+    const tip = commit("a b"); // main shrank the list after the branch was cut
+    git("checkout", "-q", "feature");
+
+    const base = ratchetBase("main", readIn);
+    expect(base).toBe(fork);
+    expect(git("show", `${base}:allowlist.ts`)).toBe("a b c");
+
+    // A merge-queue build: the batch sits on top of the base tip.
+    git("checkout", "-q", "-b", "queue", "main");
+    commit("a b // batch");
+    expect(ratchetBase("main", readIn)).toBe(tip);
+  });
+
+  it("falls back to the ref when it does not resolve", () => {
+    expect(ratchetBase("origin/missing", readIn)).toBe("origin/missing");
+  });
+});
