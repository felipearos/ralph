{
  "$schema": "https://opencode.ai/config.json",

  // Executor config for the Ralph loop's implementation sub-agent.
  // Loaded only via OPENCODE_CONFIG from ralph/delegate.sh, so it never
  // affects an interactive `opencode` run or the user's global config.
  //
  // The orchestrating iteration — named in `ralph/models.json` — owns
  // orchestration, review, git, gh and the verification gates. This model owns
  // the code generation and nothing else.

  // The model is the lineup's, not this file's: `ralph/models.json` names it,
  // `ralph/models.ts` resolves it, and `ralph/delegate.sh` exports it into the
  // executor's otherwise-cleared environment. Hardcoding it here is how the
  // rails file and the `-m` flag came to be able to name different models.
  "model": "{env:RALPH_MODEL_EXECUTOR}",
  "autoupdate": false,
  "share": "disabled",

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "question": "deny",

    // delegate.sh passes --auto, which approves anything not denied here.
    // This list IS the rail.
    //
    // ORDER MATTERS: last match wins. The catch-all `"*": "allow"` must come
    // FIRST — put it last and it silently overrides every deny below it. That
    // is not theoretical: with the catch-all last, the executor happily ran
    // `git commit` and `gh pr list` in a probe.
    //
    // ANCHORING MATTERS TOO: each pattern is globbed against the raw command
    // string, so a bare prefix like `"git commit*"` only matches a command that
    // BEGINS with it. The matcher does not look inside `&&`- or `;`-chained
    // subcommands, so `true && git push` sailed straight past `"git push*"`.
    // Every rail wraps its verb in `*…*` so it matches wherever it appears.
    "bash": {
      "*": "allow",

      // History and remote state belong to the orchestrator.
      "*git commit*": "deny",
      "*git push*": "deny",
      "*git merge*": "deny",
      "*git rebase*": "deny",
      "*git reset*": "deny",
      "*git revert*": "deny",
      "*git checkout*": "deny",
      "*git switch*": "deny",
      "*git branch*": "deny",
      "*git worktree*": "deny",
      "*git stash*": "deny",
      "*git clean*": "deny",
      "*gh *": "deny",

      // Every migration is a prod migration: dev/stg/prd share one Supabase DB.
      "*db:migrate*": "deny",
      "*drizzle-kit push*": "deny",
      "*psql*": "deny",
      "*supabase*": "deny",
      "*bunx supabase*": "deny",
      "*doppler*": "deny",

      // E2E belongs to CI, not to this machine: nobody in the loop runs it,
      // the orchestrator included. The rest are machine-wide.
      "*test:e2e*": "deny",
      "*playwright*": "deny",
      "*rm -rf*": "deny",
      "*sudo*": "deny",
      "*pkill*": "deny",
      "*curl*": "deny",
      "*publish*": "deny"
    }
  },

  "agent": {
    "ralph-coder": {
      "mode": "primary",
      "description": "Implements one narrow, fully-specified change. Never plans the backlog, never commits.",
      "model": "{env:RALPH_MODEL_EXECUTOR}",
      "temperature": 0
    }
  }
}
